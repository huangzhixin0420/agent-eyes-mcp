{
  "name": "agent-eyes-mcp",
  "version": "0.2.0",
  "description": "Give text-only LLM agents eyes: an MCP server + CLI that describes images through a vision-language model (VLM) API.",
  "type": "module",
  "bin": {
    "agent-eyes-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "vlm",
    "multimodal",
    "llm",
    "agent",
    "cli",
    "qwen",
    "dashscope",
    "screenshot",
    "ocr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangzhixin0420/agent-eyes-mcp.git"
  },
  "bugs": "https://github.com/huangzhixin0420/agent-eyes-mcp/issues",
  "homepage": "https://github.com/huangzhixin0420/agent-eyes-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ipaddr.js": "^2.5.0",
    "sharp": "^0.35.3",
    "undici": "^8.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
